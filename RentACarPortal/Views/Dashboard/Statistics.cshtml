@{
    ViewData["Title"] = "Rental Statistics";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Statistics — FleetDrive</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="~/css/styles.css" rel="stylesheet">
    <style>
            .chart-wrapper {
                position: relative;
                height: 320px;
                width: 100%;
            }
    </style>
</head>
<body class="dashboard-body">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom fixed-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" href="/Home/Index">
                <span class="brand-icon"><i class="bi bi-car-front-fill"></i></span>
                <span class="brand-text">FleetDrive</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link active" href="/Statistics/Index">Statistics</a>
                    </li>
                </ul>
                <div class="d-flex align-items-center gap-3">
                    <span class="dashboard-user d-none d-md-inline">
                        <i class="bi bi-person-circle me-1"></i> @(ViewBag.Username ?? "Admin")
                    </span>
                    <a href="/Login/LoginForm" class="btn btn-outline-primary btn-sm px-4">Log Out</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="dashboard-page">
        <div class="container">

            <!-- Page Header -->
            <div class="dashboard-header">
                <div>
                    <span class="section-label">Analytics</span>
                    <h1 class="dashboard-title">Fleet Statistics</h1>
                    <p class="dashboard-subtitle">Monitor utilization, revenue, and popular vehicles across your fleet.</p>
                </div>
                <div class="dashboard-header-badge icon-stats">
                    <i class="bi bi-bar-chart-fill"></i>
                </div>
            </div>

            <!-- Charts Grid -->
            <div class="row g-4 mb-4">

                <!-- Utilization Rate (Line Chart) -->
                <div class="col-lg-8">
                    <div class="chart-card">
                        <div class="chart-header">
                            <h3 class="chart-title"><i class="bi bi-activity text-primary me-2"></i> Fleet Utilization Rate</h3>
                        </div>
                        <div class="chart-wrapper">
                            <canvas id="utilizationChart"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Top Revenue Generating Vehicles (Doughnut Chart) -->
                <div class="col-lg-4">
                    <div class="chart-card">
                        <div class="chart-header">
                            <h3 class="chart-title"><i class="bi bi-cash-stack text-success me-2"></i> Top Revenue Sources</h3>
                        </div>
                        <div class="chart-wrapper d-flex align-items-center justify-content-center">
                            <canvas id="revenueChart"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Most Popular Vehicles (Vertical Bar Chart) -->
                <div class="col-lg-6">
                    <div class="chart-card">
                        <div class="chart-header">
                            <h3 class="chart-title"><i class="bi bi-star-fill text-warning me-2"></i> Most Popular Vehicles (Rentals)</h3>
                        </div>
                        <div class="chart-wrapper">
                            <canvas id="popularChart"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Average Rental Duration (Horizontal Bar Chart) -->
                <div class="col-lg-6">
                    <div class="chart-card">
                        <div class="chart-header">
                            <h3 class="chart-title"><i class="bi bi-clock-history text-info me-2"></i> Avg. Rental Duration (Days)</h3>
                        </div>
                        <div class="chart-wrapper">
                            <canvas id="durationChart"></canvas>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="footer py-4 mt-auto">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                    <span class="footer-brand"><i class="bi bi-car-front-fill me-2"></i>FleetDrive</span>
                    <span class="text-muted ms-2">&copy; 2026 FleetDrive. All rights reserved.</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- Chart Configurations -->
    <script>
            document.addEventListener('DOMContentLoaded', function() {

                const primaryColor = '#0d6efd';
                const primaryLight = 'rgba(13, 110, 253, 0.2)';
                const successColor = '#198754';
                const warningColor = '#cc9a06';
                const infoColor = '#0aa2c0';
                const purpleColor = '#6f42c1';
                const darkColor = '#1a1f36';
                const gridColor = '#e9ecef';

                Chart.defaults.font.family = '"Inter", sans-serif';
                Chart.defaults.color = '#6c757d';
                Chart.defaults.plugins.tooltip.backgroundColor = darkColor;
                Chart.defaults.plugins.tooltip.padding = 10;
                Chart.defaults.plugins.tooltip.cornerRadius = 8;

                // 1. Utilization Rate (Line Chart)
                const ctxUtilization = document.getElementById('utilizationChart').getContext('2d');
                new Chart(ctxUtilization, {
                    type: 'line',
                    data: {
                        labels: @Html.Raw(Json.Serialize(ViewBag.UtilizationMonths)),
                        datasets: [{
                            label: 'Utilization %',
                            data: @Html.Raw(Json.Serialize(ViewBag.UtilizationValues)),
                            borderColor: primaryColor,
                            backgroundColor: primaryLight,
                            borderWidth: 3,
                            tension: 0.4,
                            fill: true,
                            pointBackgroundColor: '#fff',
                            pointBorderColor: primaryColor,
                            pointBorderWidth: 2,
                            pointRadius: 6,
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { beginAtZero: true, max: 100, grid: { color: gridColor } },
                            x: { grid: { display: false } }
                        }
                    }
                });

                // 2. Top Revenue Generating (Doughnut Chart)
                const ctxRevenue = document.getElementById('revenueChart').getContext('2d');
                new Chart(ctxRevenue, {
                    type: 'doughnut',
                    data: {
                        labels: @Html.Raw(Json.Serialize(ViewBag.RevenueLabels)),
                        datasets: [{
                            data: @Html.Raw(Json.Serialize(ViewBag.RevenueValues)),
                            backgroundColor: [primaryColor, purpleColor, infoColor, warningColor],
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '75%',
                        plugins: {
                            legend: { position: 'bottom', labels: { usePointStyle: true, padding: 20 } }
                        }
                    }
                });

                // 3. Most Popular Vehicles (Vertical Bar Chart)
                const ctxPopular = document.getElementById('popularChart').getContext('2d');
                new Chart(ctxPopular, {
                    type: 'bar',
                    data: {
                        labels: @Html.Raw(Json.Serialize(ViewBag.PopularLabels)),
                        datasets: [{
                            label: 'Vehicle Score',
                            data: @Html.Raw(Json.Serialize(ViewBag.PopularValues)),
                            backgroundColor: primaryColor,
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { beginAtZero: true, grid: { color: gridColor } },
                            x: { grid: { display: false } }
                        }
                    }
                });

                // 4. Average Rental Duration (Horizontal Bar Chart)
                const ctxDuration = document.getElementById('durationChart').getContext('2d');
                new Chart(ctxDuration, {
                    type: 'bar',
                    data: {
                        labels: @Html.Raw(Json.Serialize(ViewBag.DurationLabels)),
                        datasets: [{
                            label: 'Days',
                            data: @Html.Raw(Json.Serialize(ViewBag.DurationValues)),
                            backgroundColor: infoColor,
                            borderRadius: 6,
                            barPercentage: 0.7
                        }]
                    },
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            x: { beginAtZero: true, grid: { color: gridColor } },
                            y: { grid: { display: false } }
                        }
                    }
                });
            });
    </script>
</body>
</html>