@model RentACarPortal.Models.BookingContractRequest
@{
    ViewData["Title"] = "Review Contract Request";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Review Contract Request — FleetDrive</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="~/css/styles.css" rel="stylesheet">
</head>
<body class="dashboard-body">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom fixed-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" href="/Home/Index">
                <span class="brand-icon"><i class="bi bi-car-front-fill"></i></span>
                <span class="brand-text">FleetDrive</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link active" href="/Dashboard/Index">Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Home/Index">Home</a>
                    </li>
                </ul>
                <div class="d-flex align-items-center gap-3">
                    <span class="dashboard-user d-none d-md-inline">
                        <i class="bi bi-person-circle me-1"></i> @(ViewBag.Username ?? "Admin")
                    </span>
                    <a href="/Login/LoginForm" class="btn btn-outline-primary btn-sm px-4">Log Out</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="dashboard-page">
        <div class="container">

            <!-- Page Header -->
            <div class="mb-4">
                <a href="/Dashboard/Index" class="text-decoration-none text-muted mb-3 d-inline-block">
                    <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
                </a>
                <h1 class="h3 fw-bold text-dark mb-1">Review Contract Request</h1>
                <p class="text-muted">Review the submitted client details and requested vehicle before making a decision.</p>
            </div>

            <!-- Rental Information & Pricing Section -->
            <div class="form-section-card">
                <div class="form-section-header">
                    <div class="form-section-icon icon-rental-detail">
                        <i class="bi bi-calendar-range"></i>
                    </div>
                    <div>
                        <h2>Rental Period & Pricing</h2>
                        <p>Specified dates, duration length, and total calculated cost.</p>
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-md-4">
                        <span class="d-block text-muted small fw-semibold text-uppercase mb-1">Rental Start Date</span>
                        <span class="d-block text-dark fw-medium fs-6">@Model.RentStartDate.ToString("dd MMM yyyy")</span>
                    </div>
                    <div class="col-md-4">
                        <span class="d-block text-muted small fw-semibold text-uppercase mb-1">Rental Duration</span>
                        <span class="d-block text-dark fw-medium fs-6">@Model.RentLenght Days</span>
                    </div>
                    <div class="col-md-4">
                        <span class="d-block text-muted small fw-semibold text-uppercase mb-1">Total Calculated Cost</span>
                        <span class="d-block text-primary fw-bold fs-5">$@Model.TotalPrice.ToString("N2")</span>
                    </div>
                </div>
            </div>

            <!-- Client Information Section -->
            <div class="form-section-card">
                <div class="form-section-header">
                    <div class="form-section-icon icon-user-detail">
                        <i class="bi bi-person-vcard"></i>
                    </div>
                    <div>
                        <h2>Client Information</h2>
                        <p>Personal and identification details provided by the driver.</p>
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-md-4">
                        <span class="d-block text-muted small fw-semibold text-uppercase mb-1">Driver Full Name</span>
                        <span class="d-block text-dark fw-medium fs-5">@Model.DriverFullName</span>
                    </div>
                    <div class="col-md-4">
                        <span class="d-block text-muted small fw-semibold text-uppercase mb-1">Date of Birth</span>
                        <span class="d-block text-dark fw-medium fs-6">@Model.DateOfBirth.ToString("dd MMM yyyy")</span>
                    </div>
                    <div class="col-md-4">
                        <span class="d-block text-muted small fw-semibold text-uppercase mb-1">Personal ID Number</span>
                        <span class="d-block text-dark fw-medium fs-6">@Model.PersonalIdNumber</span>
                    </div>

                    <div class="col-md-4">
                        <span class="d-block text-muted small fw-semibold text-uppercase mb-1">Telephone</span>
                        <span class="d-block text-dark fw-medium fs-6">@Model.Telephone</span>
                    </div>
                    <div class="col-md-8">
                        <span class="d-block text-muted small fw-semibold text-uppercase mb-1">Home Address</span>
                        <span class="d-block text-dark fw-medium fs-6">@Model.Address</span>
                    </div>

                    <div class="col-md-4">
                        <span class="d-block text-muted small fw-semibold text-uppercase mb-1">Driving License Number</span>
                        <span class="d-block text-dark fw-medium fs-6">@Model.DrivingLicenseNumber</span>
                    </div>
                    <div class="col-md-4">
                        <span class="d-block text-muted small fw-semibold text-uppercase mb-1">Passport Number</span>
                        <span class="d-block text-dark fw-medium fs-6">@Model.PassportNumber</span>
                    </div>
                    <div class="col-md-2">
                        <span class="d-block text-muted small fw-semibold text-uppercase mb-1">Date of Issue</span>
                        <span class="d-block text-dark fw-medium fs-6">@Model.DateOfIssue.ToString("dd MMM yyyy")</span>
                    </div>
                    <div class="col-md-2">
                        <span class="d-block text-muted small fw-semibold text-uppercase mb-1">Place of Issue</span>
                        <span class="d-block text-dark fw-medium fs-6">@Model.PlaceOfIssue</span>
                    </div>
                </div>
            </div>

            <!-- Additional Notes Section -->
            <div class="form-section-card">
                <div class="form-section-header">
                    <div class="form-section-icon icon-notes-detail">
                        <i class="bi bi-card-text"></i>
                    </div>
                    <div>
                        <h2>Client Notes</h2>
                        <p>Additional requests or remarks from the client.</p>
                    </div>
                </div>
                <div class="p-3 bg-light rounded border">
                    <p class="mb-0 text-dark">
                        @Model.Notes
                    </p>
                </div>
            </div>

            <!-- Requested Vehicle Section -->
            <div class="form-section-card">
                <div class="form-section-header">
                    <div class="form-section-icon icon-rental-detail">
                        <i class="bi bi-car-front"></i>
                    </div>
                    <div>
                        <h2>Requested Vehicle</h2>
                        <p>The specific make and model selected for this contract.</p>
                    </div>
                </div>

                <div class="d-flex align-items-center p-3 border rounded">
                    <div class="flex-shrink-0 bg-light rounded p-3 me-4 text-primary fs-3 border">
                        <i class="bi bi-car-front-fill"></i>
                    </div>
                    <div>
                        <span class="d-block text-muted small fw-semibold text-uppercase mb-1">Vehicle Selection</span>
                        <span class="d-block text-dark fw-bold fs-4">@(Model.Vehicle != null ? $"{Model.Vehicle.Make} {Model.Vehicle.Model}" : "No vehicle assigned")</span>
                        <span class="badge bg-success mt-1">Available in Fleet</span>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex align-items-center justify-content-end gap-3 mt-2 mb-5">
                <form method="post" action="/ContractRequestDetails/DeclineRequest">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="loggedInUser" value="@ViewBag.Username" />
                    <button type="submit" class="btn btn-danger btn-lg px-5 fw-bold rounded-3 shadow-sm">
                        <i class="bi bi-x-circle me-2"></i> Decline
                    </button>
                </form>

                <form method="post" action="/ContractRequestDetails/AcceptRequest">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="loggedInUser" value="@ViewBag.Username" />
                    <button type="submit" class="btn btn-success btn-lg px-5 fw-bold rounded-3 shadow-sm">
                        <i class="bi bi-check-circle me-2"></i> Accept
                    </button>
                </form>
            </div>

        </div>
    </main>

    <!-- Footer -->
    <footer class="footer py-4 mt-auto">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                    <span class="footer-brand"><i class="bi bi-car-front-fill me-2"></i>FleetDrive</span>
                    <span class="text-muted ms-2">&copy; 2026 FleetDrive. All rights reserved.</span>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <a href="#" class="footer-link me-3">Privacy Policy</a>
                    <a href="#" class="footer-link me-3">Terms of Service</a>
                    <a href="#" class="footer-link">Contact Us</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
