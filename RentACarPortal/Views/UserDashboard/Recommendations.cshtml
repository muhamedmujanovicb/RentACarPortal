@model IEnumerable<RentACarPortal.Models.Vehicle>
@{
    ViewData["Title"] = "Recommendations";
    var topWinner = Model?.FirstOrDefault();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recommendations — FleetDrive</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="~/css/styles.css" rel="stylesheet" asp-append-version="true">
</head>
<body class="dashboard-body">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom fixed-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" href="index.html">
                <span class="brand-icon"><i class="bi bi-car-front-fill"></i></span>
                <span class="brand-text">FleetDrive</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" href="user-dashboard.html">My Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="recommendor.html">Recommendor</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="index.html">Home</a>
                    </li>
                </ul>
                <div class="d-flex align-items-center gap-3">
                    <span class="dashboard-user d-none d-md-inline">
                        <i class="bi bi-person-circle me-1"></i> User
                    </span>
                    <a href="login.html" class="btn btn-outline-primary btn-sm px-4">Log Out</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Recommendations -->
    <main class="dashboard-page">
        <div class="container">

            <header class="dashboard-header">
                <div>
                    <span class="section-label text-white-50">Your Results</span>
                    <h1 class="dashboard-title">Recommended Vehicles</h1>
                    <p class="dashboard-subtitle">Based on your preferences and trip details, here are the best matches for you.</p>
                </div>
                <div class="dashboard-header-badge">
                    <i class="bi bi-trophy"></i>
                </div>
            </header>

            <div class="row justify-content-center">
                <div class="col-lg-10">

                    <!-- Recommended Cars List -->
                    <div class="d-flex flex-column gap-3 mb-5">

                        @if (Model == null || !Model.Any())
                        {
                            <div class="form-section-card p-4 text-center">
                                <p class="text-muted mb-0">No vehicles match your criteria and budget.</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var car in Model)
                            {
                                <!-- Car Item -->
                                <div class="form-section-card">
                                    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between p-4 gap-3">
                                        <div class="d-flex align-items-center gap-4">
                                            <div class="form-section-icon icon-fleet" style="width: 56px; height: 56px; font-size: 1.5rem;">
                                                <i class="bi bi-car-front-fill"></i>
                                            </div>
                                            <div>
                                                <h4 class="mb-0 fw-bold text-dark d-flex align-items-center flex-wrap gap-2">
                                                    @car.Make @car.Model <span class="fw-normal text-muted fs-5">( @car.TypeOfVehicle )</span>
                                                    <span class="text-muted d-none d-md-inline">|</span>
                                                    <span class="text-primary">Rate: €@car.DailyRate.ToString("N0")/day</span>
                                                </h4>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }

                    </div>

                    <!-- Winner Category Display -->
                    <div class="form-section-card border-primary p-5 text-center mt-4" style="border-width: 2px; background: rgba(13, 110, 253, 0.03);">
                        <div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-circle mb-3 shadow-sm" style="width: 64px; height: 64px; font-size: 1.75rem;">
                            <i class="bi bi-award"></i>
                        </div>
                        <h5 class="text-uppercase text-muted fw-bold mb-2" style="letter-spacing: 0.05em;">Winner Category</h5>
                        <h2 class="display-5 fw-bold text-primary mb-0">@(topWinner != null ? topWinner.TypeOfVehicle : "None")</h2>
                    </div>

                </div>
            </div>

        </div>
    </main>

    <footer class="footer py-4 mt-auto">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                    <span class="footer-brand"><i class="bi bi-car-front-fill me-2"></i>FleetDrive</span>
                    <span class="text-muted ms-2">&copy; 2026 FleetDrive. All rights reserved.</span>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <a href="#" class="footer-link me-3">Privacy Policy</a>
                    <a href="#" class="footer-link me-3">Terms of Service</a>
                    <a href="#" class="footer-link">Contact Us</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
